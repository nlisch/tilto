#### DEV ###
# Environment
FLASK_DEBUG=True
FLASK_APP=app.py

# Database
DB_HOST="localhost"
DB_PORT=3306
DB_NAME="flask_database"
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"

# Flask Secret Key
SECRET_KEY="generate_a_random_secret_key"

# LLM
ANTHROPIC_API_KEY="sk-ant-..."

# Anthropic Model Configuration
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=16384
ANTHROPIC_TEMPERATURE=0.7

# Web Search Configuration
ENABLE_WEB_SEARCH=True

# Audio Transcript
OPENAI_API_KEY="sk-proj-..."

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_REDIRECT_URI=https://your-domain.com/login/google/authorized

# Database Pool
DB_POOL_NAME=dev-pool
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=30
DB_READ_TIMEOUT=10
DB_WRITE_TIMEOUT=5

# Storage
STORAGE_BUCKET="your-storage-bucket"
DATA_BUCKET="your-data-bucket"
CDN_URL="http://localhost:8080/images"

# Prelaunch
PRELAUNCH_MODE=False

# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
WTF_CSRF_ENABLED=False

# Stripe Product
STRIPE_PRODUCTS=stripe_products.json

# CSP
CSP_POLICY_FILE=csp_policy.json

# YouCanBookMe
YOUCANBOOK_BASE_URL=https://your-subdomain.youcanbook.me
YOUCANBOOK_BOOKING_PAGE=your-booking-page
YOUCANBOOK_SUBDOMAIN=your-subdomain
YOUCANBOOK_WEBHOOK_SECRET=your_webhook_secret_here

# Brevo SMTP (Email)
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_brevo_username
MAIL_PASSWORD=your_brevo_password
MAIL_DEFAULT_SENDER=contact@yourdomain.com
BREVO_FROM_NAME=Tilto

# GCP
GOOGLE_CLOUD_PROJECT_DEV="your-gcp-project-id"
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/credentials.json

# Cloud Tasks
CLOUD_TASKS_LOCATION=europe-west1
CLOUD_TASKS_QUEUE=analysis-generation
APP_URL=http://localhost:5000
CLOUD_TASKS_SECRET=dev-secret-change-in-prod

# Audio bucket
QUIZ_AUDIO_BUCKET=your_quiz_audios_bucket

# Anonymization
ANONYMIZATION_SERVICE_URL="https://your-anonymization-service.run.app"
ANONYMIZATION_ENABLED=True

# Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Facebook Pixel
FACEBOOK_PIXEL_ID=

# Google Ads
GOOGLE_ADS_ID=AW-XXXXXXXXXXX
GOOGLE_ADS_CONVERSION_LABEL=your_conversion_label

# Slack
SLACK_WEBHOOK_URL_LEADS=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_URL_MONITORING=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_URL_CHAT=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_NAME=Tilto Bot
SLACK_BOT_EMOJI=:rocket:

# Admin bypass
PRELAUNCH_BYPASS_KEY=your_bypass_key

# France Travail
FRANCE_TRAVAIL_CLIENT_ID=your_client_id
FRANCE_TRAVAIL_CLIENT_SECRET=your_client_secret

# Logo.dev
LOGO_DEV_PUBLIC_KEY=your_logo_dev_key
